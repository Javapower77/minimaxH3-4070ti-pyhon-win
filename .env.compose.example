# Copy to .env before using Docker Compose.
# HF_TOKEN is only passed to the one-time setup profile. Leave empty for public files.
HF_TOKEN=

MINIMAX_H3_PORT=7860
MINIMAX_H3_COMFY_RESERVE_VRAM_GB=1.0

# Keep below the 64 GB physical host limit so Ubuntu and Docker retain headroom.
MINIMAX_H3_MEMORY_LIMIT=60g
# Requires host swap. Increase only when sufficient swap/NVMe space is configured.
MINIMAX_H3_MEMORY_SWAP_LIMIT=76g
