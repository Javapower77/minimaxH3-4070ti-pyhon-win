# Copy to .env. Runtime is air-gapped. HF_TOKEN is only used by
# scripts/download_models.py (the one online step).

# Hugging Face token — download script only. Never used at inference.
HF_TOKEN=
HF_HUB_ENABLE_HF_TRANSFER=1

# Put caches on the 2 TB data disk, not the OS disk.
HF_HOME=/mnt/disk2TB/minimaxH3/.hf_cache
HUGGINGFACE_HUB_CACHE=/mnt/disk2TB/minimaxH3/.hf_cache/hub

# Offline runtime pins (app.py / generate.py also force these).
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
DIFFUSERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
GRADIO_ANALYTICS_ENABLED=False
GRADIO_SHARE=0

# Local snapshot of MiniMaxAI/MiniMax-H3. Inference will not fall back to Hub.
MINIMAX_H3_MODEL_ID=MiniMaxAI/MiniMax-H3
MINIMAX_H3_LOCAL_DIR=/mnt/disk2TB/minimaxH3/models/MiniMax-H3

# Default Turbo LoRA (Diffusers PEFT safetensors, not the ComfyUI file).
MINIMAX_H3_LORA_DIR=/mnt/disk2TB/minimaxH3/models/loras
MINIMAX_H3_DEFAULT_LORA=fl2va_turbo_8step_768p

# Runtime
MINIMAX_H3_DEVICE=cuda
MINIMAX_H3_DTYPE=bfloat16
MINIMAX_H3_CPU_OFFLOAD=1
MINIMAX_H3_MEMORY_RESERVE_MARGIN=20GB
MINIMAX_H3_ATTENTION_BACKEND=_flash_3
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Gradio listens on 0.0.0.0:7860 so Azure NSG can reach it from your IP.
# Share tunnels stay disabled. Do not set GRADIO_SERVER_NAME=127.0.0.1.
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
